+bool PlayerbotFactory::ApplyStrictBisEquipment(Player* bot)
+{
+    std::map<uint8, uint32> const bisMap = sBisListMgr->GetStrictBisSet(bot);
+    if (bisMap.empty())
+        return false;
+
+    // 1. Drop every equipped piece the list does not ask for in that exact slot.
+    //    This is what keeps a bot from carrying Phase 3 leftovers into a Phase 1 set.
+    for (uint8 slot = EQUIPMENT_SLOT_START; slot < EQUIPMENT_SLOT_END; ++slot)
+    {
+        if (slot == EQUIPMENT_SLOT_BODY || slot == EQUIPMENT_SLOT_TABARD)
+            continue;
+
+        Item* equipped = bot->GetItemByPos(INVENTORY_SLOT_BAG_0, slot);
+        if (!equipped)
+            continue;
+
+        auto const it = bisMap.find(slot);
+        bool const isWantedHere = it != bisMap.end() && it->second == equipped->GetEntry();
+        bool const uncovered = it == bisMap.end();
+
+        if (isWantedHere)
+            continue;
+
+        // Slot not covered by the list: keep the current piece unless the server asked
+        // for a literal "BiS or nothing" bot.
+        if (uncovered && !sPlayerbotAIConfig.randomBotStrictBisClearUncovered)
+            continue;
+
+        bot->DestroyItem(INVENTORY_SLOT_BAG_0, slot, true);
+    }
+
+    // 2. Destroy equippable bag items: a unique-equipped duplicate sitting in a bag
+    //    blocks CanEquipNewItem, and leftover gear would be re-equipped by EquipAction.
+    auto destroyIfEquippable = [&](uint8 bag, uint8 slot)
+    {
+        Item* item = bot->GetItemByPos(bag, slot);
+        if (!item)
+            return;
+        ItemTemplate const* tmpl = item->GetTemplate();
+        if (!tmpl)
+            return;
+        if (tmpl->Class == ITEM_CLASS_WEAPON || tmpl->Class == ITEM_CLASS_ARMOR)
+            bot->DestroyItem(bag, slot, true);
+    };
+    for (uint8 slot = INVENTORY_SLOT_ITEM_START; slot < INVENTORY_SLOT_ITEM_END; ++slot)
+        destroyIfEquippable(INVENTORY_SLOT_BAG_0, slot);
+    for (uint8 bag = INVENTORY_SLOT_BAG_START; bag < INVENTORY_SLOT_BAG_END; ++bag)
+    {
+        if (Bag* container = bot->GetBagByPos(bag))
+            for (uint32 slot = 0; slot < container->GetBagSize(); ++slot)
+                destroyIfEquippable(bag, slot);
+    }
+
+    // 3. Equip the list, slot by slot. Nothing outside the list is ever considered.
+    for (auto const& kv : bisMap)
+    {
+        uint8 const slot = kv.first;
+        uint32 const itemId = kv.second;
+
+        ItemTemplate const* proto = sObjectMgr->GetItemTemplate(itemId);
+        if (!proto)
+            continue;
+
+        if (Item* equipped = bot->GetItemByPos(INVENTORY_SLOT_BAG_0, slot))
+        {
+            if (equipped->GetEntry() == itemId)
+                continue;  // already correct
+            bot->DestroyItem(INVENTORY_SLOT_BAG_0, slot, true);
+        }
+
+        if (sPlayerbotAIConfig.randomBotStrictBisGrantReputation && proto->RequiredReputationFaction &&
+            proto->RequiredReputationRank > 0)
+        {
+            if (FactionEntry const* fac = sFactionStore.LookupEntry(proto->RequiredReputationFaction))
+            {
+                ReputationRank const requiredRank = static_cast<ReputationRank>(proto->RequiredReputationRank);
+                if (bot->GetReputationRank(proto->RequiredReputationFaction) < requiredRank)
+                {
+                    int32 const standing =
+                        ReputationMgr::ReputationRankToStanding(static_cast<ReputationRank>(requiredRank - 1)) + 1;
+                    bot->GetReputationMgr().SetReputation(fac, standing);
+                }
+            }
+        }
+
+        if (bot->CanUseItem(proto) != EQUIP_ERR_OK)
+            continue;  // class/race/skill/level gate: leave the slot empty rather than off-list
+
+        uint16 dest = 0;
+        InventoryResult eqResult = bot->CanEquipNewItem(slot, dest, itemId, false);
+
+        // Paired slots (finger 10<->11, trinket 12<->13): a unique-equipped twin in the
+        // other slot blocks the first attempt, so clear it and retry once.
+        if (eqResult != EQUIP_ERR_OK)
+        {
+            uint8 pairedSlot = 0xFF;
+            if (slot == EQUIPMENT_SLOT_FINGER1)             pairedSlot = EQUIPMENT_SLOT_FINGER2;
+            else if (slot == EQUIPMENT_SLOT_FINGER2)        pairedSlot = EQUIPMENT_SLOT_FINGER1;
+            else if (slot == EQUIPMENT_SLOT_TRINKET1)       pairedSlot = EQUIPMENT_SLOT_TRINKET2;
+            else if (slot == EQUIPMENT_SLOT_TRINKET2)       pairedSlot = EQUIPMENT_SLOT_TRINKET1;
+
+            if (pairedSlot != 0xFF && bisMap.find(pairedSlot) == bisMap.end())
+            {
+                if (bot->GetItemByPos(INVENTORY_SLOT_BAG_0, pairedSlot))
+                    bot->DestroyItem(INVENTORY_SLOT_BAG_0, pairedSlot, true);
+                eqResult = bot->CanEquipNewItem(slot, dest, itemId, false);
+            }
+        }
+
+        if (eqResult == EQUIP_ERR_OK)
+        {
+            bot->EquipNewItem(dest, itemId, true);
+            bot->AutoUnequipOffhandIfNeed();
+        }
+    }
+
+    return true;
+}
