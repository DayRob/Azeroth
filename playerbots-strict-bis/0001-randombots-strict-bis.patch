+# Strict BiS mode for randombots
+# When enabled, randombots no longer itemise themselves with the stat-weight "is this an upgrade"
+# logic. Instead they wear exactly the rows of playerbots_bis_gear that match their class/spec and
+# the configured tier, and they only roll NEED on items from that same list.
+# Consequences:
+#  - no cross-phase mixing: only rows whose auto_gear_score_limit equals RandomBotStrictBisIlvl are
+#    used (no closest-lower fallback, unlike the "autogear bis" chat command)
+#  - a slot with no row stays as configured by RandomBotStrictBisClearUncovered
+#  - off-list loot is never equipped and never rolled NEED on (it is treated as vendor/AH/DE trash)
+#  - tier tokens are passed on, since a bot cannot trade one in and the list stores final item ids
+# Only applies to randombots. Addclass bots and player altbots keep the normal logic and the
+# on-demand "autogear bis" command.
+# Default: 0 (disabled)
+AiPlayerbot.RandomBotStrictBis = 0
+
+# Tier used by strict BiS mode, matched EXACTLY against playerbots_bis_gear.auto_gear_score_limit.
+# Vanilla: 66 (T1) 76 (T2) 78 (P1 MC/Ony/ZG) 83 (P2 BWL) 88 (P2.5 AQ40) 92 (P3 Naxx40)
+# TBC:     120 (Pre-Raid) 125 (P1 Kara) 141 (P2 SSC/TK) 156 (P3 Hyjal/BT) 164 (P4 Sunwell)
+# WotLK:   200 213 224 (P1 Naxx) 245 (P2 Ulduar) 258 (P3 ToC) 264 290 (P4 ICC)
+# 0 = fall back to AiPlayerbot.AutoGearScoreLimit.
+# Default: 0
+AiPlayerbot.RandomBotStrictBisIlvl = 0
+
+# Minimum bot level for strict BiS mode. BiS lists only contain level-cap gear for their tier, so
+# leveling bots must keep the normal itemisation or they would run around naked.
+# 0 = use AiPlayerbot.RandomBotMaxLevel.
+# Default: 0
+AiPlayerbot.RandomBotStrictBisMinLevel = 0
+
+# What to do with equipment slots that have no row in the BiS list (e.g. ranged for a paladin, or
+# an incomplete list).
+# 1 = strip them (literal "BiS or nothing")
+# 0 = leave whatever the bot is already wearing there
+# Default: 1
+AiPlayerbot.RandomBotStrictBisClearUncovered = 1
+
+# Grant the reputation rank required by a BiS item before equipping it. Without this, every
+# reputation-gated BiS piece silently leaves its slot empty.
+# Default: 1 (enabled)
+AiPlayerbot.RandomBotStrictBisGrantReputation = 1
+
 # Equipment quality limitation for randombots (1 = normal, 2 = uncommon, 3 = rare, 4 = epic, 5 = legendary)
 # This also sets the maximum quality that can be generated by autogear for randombots and altbots
 # Default: 3 (rare)
